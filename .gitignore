# ─── 비밀값 ───────────────────────────────────────────────
.env
*.env
.env.local
epta/.env
epta/web/.env.local

# ─── 원본 자료 (용량 크고 변하지 않음. 로컬에만 둔다) ─────
*.pdf

# ─── 생성물 : 다시 만들 수 있으므로 커밋하지 않는다 ───────
# TTS 음성 — practice/build.py 로 언제든 재생성 (같은 문장은 해시 캐시로 재사용)
*.mp3
*.wav
*.m4a
*.flac
epta/web/audio/
# 실제 출제 녹음 — 용량이 크고 저작권이 있으므로 로컬에만 둔다
epta/reference/audio/
# 서버에서 내려받은 응시 기록 — 답안 원문은 sets/*_feedback.md 에 그대로 인용돼
# 커밋되므로 여기 두지 않는다. (2026-11-03 주의 : "pull.py 로 다시 받는다"는 전제는
# 서버 Blob 이 살아 있을 때만 참이다. 스토어가 정지되자 다시 받을 수 없었다.)
epta/practice/results/
# 응시 녹음 백업 — backup.py 가 받아 둔 원본. 용량이 커서 커밋하지 않는다.
# 이게 유일한 사본이므로 절대 지우지 말 것. webm 은 확장자 규칙에 안 걸리므로 명시한다.
epta/practice/recordings/
*.webm
# practice/ 의 옛 출력 경로 (지금은 web/ 로 나간다)
epta/practice/audio/

# ─── 의존성 · 배포 캐시 ──────────────────────────────────
node_modules/
.vercel
.vercel/
.next/

# ─── 파이썬 ──────────────────────────────────────────────
__pycache__/
*.pyc

# ─── OS · 편집기 ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ─── 반드시 커밋하는 것 (혼동 방지 메모) ─────────────────
# epta/reference/transcripts/*.txt  ← 실제 출제 음성 자막. 최우선 기준 자료다.
# epta/sets/*.md, epta/sets/images/*.svg
# epta/web/*.html, epta/web/*.js, epta/web/api/*.js
# epta/practice/*.py, epta/practice/template.html
